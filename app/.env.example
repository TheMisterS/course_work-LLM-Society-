# ============================================================
# Logging (configs/system_config.py)
# ============================================================
LOG_FILE=app.log
LOG_LEVEL=DEBUG

# ============================================================
# Simulation Core (configs/simulation_config.py)
# ============================================================
DEBATE_TOPIC=The impact of artificial intelligence on society?

# Voting
VOTING_QUESTION=Based on the debate, what is your final position on the topic? Do you think the impact of artificial intelligence on society is overall positive?
VOTING_OPTIONS=Strongly For,For,Neutral,Against,Strongly Against

# Model selection for debate flow
MODEL_USED_FOR_DEBATE=model_1
MODEL_USED_FOR_VOTING=model_1
MODEL_USED_FOR_SUMMARIZATION=model_1

# Debate and memory behavior
DEBATE_ROUND_COUNT=10
MEMORY_WINDOW_SIZE=5
LONG_MEMORY_ENABLED=true
LONG_MEMORY_UPDATE_INTERVAL=5
LONG_MEMORY_THRESHOLD_PERCENT=0.8

# ============================================================
# Model Providers and Profiles (configs/models_config.py)
# ============================================================
# Provider endpoints/keys
OLLAMA_URL=http://localhost:11434
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Discussion model profile: model_1
MODEL_1_PROVIDER=openrouter            # openrouter | ollama
MODEL_1_MODEL=google/gemini-2.5-pro   
MODEL_1_TEMPERATURE=0.7
MODEL_1_TOP_P=0.9
MODEL_1_TOP_K=40
MODEL_1_NUM_CTX=4096
MODEL_1_NUM_PREDICT=-1
MODEL_1_REPEAT_PENALTY=1.1
MODEL_1_MAX_TOKENS=4096

# RAG model profile
RAG_MODEL_PROVIDER=openrouter  # openrouter | ollama
RAG_MODEL=openai/gpt-4o-mini
RAG_MODEL_TEMPERATURE=0.1
RAG_MODEL_MAX_TOKENS=4096

# ============================================================
# RAG Search and Pipeline (configs/rag_config.py)
# ============================================================
# Tavily search
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=advanced

# Optional comma-separated domain whitelist.
# Leave empty to use built-in Lithuania-focused defaults.
TAVILY_INCLUDE_DOMAINS=

# Pipeline behavior
RAG_QUERY_COUNT=4
RAG_MAX_ITERATIONS=2
RAG_MIN_VIEWPOINTS=5
RAG_DEDUP_USE_LLM=false

# Persona selection and synthesis
PERSONA_TARGET_COUNT=5
SYNTHESIS_MAX_RETRIES=3

# Optional comma-separated domain whitelist for background_fetcher.
# Leave empty to use built-in defaults (wikipedia.org,en.wikipedia.org).
BACKGROUND_FETCHER_INCLUDE_DOMAINS=

# ============================================================
# Notes
# ============================================================
# PERSONA_STANCE_SCHEMA and static AGENT_PROFILES are defined in code itself