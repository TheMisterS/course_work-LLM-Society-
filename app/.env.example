# =============================================================================
#  LLM Society — example environment file
#  Copy to .env and fill in real values before running.
# =============================================================================
LOG_FILE=app.log
LOG_LEVEL=INFO
# -----------------------------------------------------------------------------
#  API Keys (required)
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=
TAVILY_API_KEY=
# -----------------------------------------------------------------------------
#  OpenRouter / LLM base config
# -----------------------------------------------------------------------------
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Local Ollama instance URL (only needed if any model uses provider=ollama)
# OLLAMA_URL=http://localhost:11434

# -----------------------------------------------------------------------------
#  RAG pipeline model  (used for query planning, extraction, dedup, synthesis)
# -----------------------------------------------------------------------------
RAG_MODEL_PROVIDER=openrouter          # openrouter | ollama
RAG_MODEL=meta-llama/llama-4-maverick    # OpenRouter model ID, e.g. openai/gpt-4o, anthropic/claude-3-5-sonnet
RAG_MODEL_TEMPERATURE=0.1
RAG_MODEL_MAX_TOKENS=16000

## -----------------------------------------------------------------------------
# Baseline model config
# -----------------------------------------------------------------------------

# if not set, it will use RAG model config values
BASELINE_MODEL_TEMPERATURE=0.7
# BASELINE_MODEL_PROVIDER=
# BASELINE_MODEL_MAX_TOKENS=
# BASELINE_MODEL_PROVIDER=

# -----------------------------------------------------------------------------
#  Discussion / debate model  (model_1 drives agent turns and voting)
# -----------------------------------------------------------------------------
MODEL_1_PROVIDER=openrouter            # openrouter | ollama
MODEL_1_MODEL=meta-llama/llama-4-maverick    # or a local Ollama model, e.g. llama3.1:8b

# OpenRouter-specific
MODEL_1_MAX_TOKENS=8192
MODEL_1_TEMPERATURE=1

# Ollama-specific (ignored when provider=openrouter)
# MODEL_1_TOP_P=0.9
# MODEL_1_TOP_K=40
# MODEL_1_NUM_CTX=4096
# MODEL_1_NUM_PREDICT=-1
# MODEL_1_REPEAT_PENALTY=1.1


# -----------------------------------------------------------------------------
#  Tavily search
# -----------------------------------------------------------------------------
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=advanced           # advanced | basic

# Comma-separated domain whitelist for the main RAG search.
# Leave blank to use the built-in Lithuanian domain list.
# TAVILY_INCLUDE_DOMAINS=lrs.lt,lrv.lt,delfi.lt,lrytas.lt,15min.lt,vz.lt,bernardinai.lt,lrt.lt,vu.lt,ktu.lt

# Comma-separated domain whitelist for background_fetcher enrichment searches.
# Leave blank to use the default (wikipedia.org, en.wikipedia.org).
# BACKGROUND_FETCHER_INCLUDE_DOMAINS=wikipedia.org,en.wikipedia.org

# -----------------------------------------------------------------------------
#  RAG pipeline behaviour
# -----------------------------------------------------------------------------
RAG_QUERY_COUNT=5                      # Tavily queries generated per iteration
RAG_MAX_ITERATIONS=5                   # Hard cap on search-extract loops
RAG_MIN_VIEWPOINTS=40                  # Stop iterating once this many viewpoints are found
RAG_DEDUP_USE_LLM=true                # Enable LLM-assisted semantic deduplication

# -----------------------------------------------------------------------------
#  Persona selection & synthesis
# -----------------------------------------------------------------------------
PERSONA_TARGET_COUNT=3                 # Total personas to generate
SYNTHESIS_MAX_RETRIES=5                # LLM retry attempts per persona before raising

# -----------------------------------------------------------------------------
#  Simulation / debate config
# -----------------------------------------------------------------------------
#DEBATE_TOPIC="The proposed 2025 amendments to Lithuania's LRT Law represent a necessary reform of public broadcaster governance and should be passed by the Seimas."
DEBATE_TOPIC="The 2024 Lithuanian Civil Union Bill represented a necessary step toward legal equality and should have been adopted by the Seimas."
VOTING_QUESTION="Based on the discussion, what is your position on the topic?"
VOTING_OPTIONS="Strongly For,For,Neutral,Against,Strongly Against"

MODEL_USED_FOR_DEBATE=model_1
MODEL_USED_FOR_VOTING=model_1
MODEL_USED_FOR_SUMMARIZATION=model_1

DEBATE_ROUND_COUNT=11
MEMORY_WINDOW_SIZE=5                   # Recent messages retained in short-term memory

LONG_MEMORY_ENABLED=true
LONG_MEMORY_UPDATE_INTERVAL=5          # Summarise every N rounds
LONG_MEMORY_THRESHOLD_PERCENT=0.6      # Trigger when short_mem is ≥ LONG_MEMORY_THRESHOLD_PERCENT% full
