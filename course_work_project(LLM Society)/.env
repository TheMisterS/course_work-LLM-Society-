LOG_FILE=logs.txt
LOG_LEVEL=DEBUG

# Configure what models get used for which phases
MODEL_USED_FOR_DEBATE=model_1
MODEL_USED_FOR_VOTING=${MODEL_USED_FOR_DEBATE}

# Model configurations *****************************************************
MODEL_1_MODEL="gpt-oss:20b"
# MODEL_1_MODEL="hf.co/DavidAU/OpenAi-GPT-oss-20b-abliterated-uncensored-NEO-Imatrix-gguf:Q5_1"

MODEL_1_TEMPERATURE=0.3
MODEL_1_TOP_P=0.9
MODEL_1_TOP_K=40
MODEL_1_NUM_CTX=4096
MODEL_1_NUM_PREDICT=-1
MODEL_1_REPEAT_PENALTY=1.1

# Simulation configurations ************************************************

    # Debate configuration
DEBATE_TOPIC="Will A.I. significantly improve human society in the next 50 years?"
DEBATE_ROUND_COUNT=10
MEMORY_WINDOW_SIZE=5
    # Voting configuration
VOTING_OPTIONS="Strongly Agree,Agree,Neutral,Disagree,Strongly Disagree"
VOTING_QUESTION="What is your stance on the debate topic?"